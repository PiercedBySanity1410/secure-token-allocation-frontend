# Frontend Environment Variables (Vite)

# 1. AWS Backend Target URL (for Vite dev server proxy)
# Change this whenever your AWS EC2 instance IP or domain changes
VITE_BACKEND_URL=http://ec2-3-231-204-13.compute-1.amazonaws.com:8080

# 2. Vercel / Production API Base URL
# For production deployments on Vercel: set to http://<YOUR-AWS-EC2-IP>:8080/api (or https://api.yourdomain.com/api)
VITE_API_BASE_URL=http://ec2-3-231-204-13.compute-1.amazonaws.com:8080/api
