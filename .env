# Frontend Environment Variables (Vite)

# 1. AWS Backend Target URL (for Vite dev server proxy & local testing)
VITE_BACKEND_URL=http://ec2-3-231-204-13.compute-1.amazonaws.com:8080

# 2. Production / Vercel API Base URL
# Relative '/api' is recommended so Vercel rewrite proxying works without Mixed Content issues.
VITE_API_BASE_URL=/api
